# =============================================================================
# srv-media — Media Server Stack Configuration
# =============================================================================
# Copier ce fichier en .env et personnaliser les valeurs avant de lancer setup.sh
#   cp .env.example .env
# =============================================================================

# --- User / Group IDs ---
# Lancer 'id' sur le host pour trouver ces valeurs
PUID=1000
PGID=1000

# --- Timezone ---
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# --- Chemins ---
# Racine des données (doit être un seul filesystem pour les hardlinks)
DATA_PATH=/data
# Stockage des configs containers
CONFIG_PATH=/opt/srv-media/config

# --- IP du serveur ---
SERVER_IP=172.0.16.126

# =============================================================================
# MEDIA SERVERS
# =============================================================================

# Plex — Token de claim : https://www.plex.tv/claim (expire en 4 min)
PLEX_CLAIM=
PLEX_ADVERTISE_IP=http://172.0.16.126:32400

# Jellyfin — URL publiée pour auto-discovery (optionnel)
JELLYFIN_PUBLISHED_SERVER_URL=

# =============================================================================
# DOWNLOAD CLIENT
# =============================================================================

# Transmission — Identifiants web UI (laisser vide = pas d'auth)
TRANSMISSION_USER=
TRANSMISSION_PASS=

# =============================================================================
# NGINX PROXY MANAGER
# =============================================================================

NPM_URL=http://172.0.16.126:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme
NPM_LETSENCRYPT_EMAIL=admin@example.com

# =============================================================================
# CLOUDFLARE DNS CHALLENGE (SSL wildcard)
# =============================================================================

CF_API_EMAIL=your-cloudflare-email@example.com
CF_API_TOKEN=your-cloudflare-api-token

# Pause (secondes) entre chaque création de proxy host
PROXY_DELAY=5

# =============================================================================
# MONITORING
# =============================================================================

# Watchtower — Planning de mise à jour (cron 6 champs)
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Grafana — Mot de passe admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# PORTS (valeurs par défaut, modifier uniquement en cas de conflit)
# =============================================================================

# Admin
DASHBOARD_HTTP_PORT=32768
DASHBOARD_HTTPS_PORT=32769
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443
DOZZLE_PORT=9999
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# Media
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920
PLEX_PORT=32400
TAUTULLI_PORT=8181
JELLYSEERR_PORT=5055

# Arr Stack
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
BAZARR_PORT=6767
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
TRANSMISSION_PORT=9091
TRANSMISSION_PEER_PORT=51413

# Musique
NAVIDROME_PORT=4533
AIRSONIC_PORT=4040

# Livres
CALIBRE_PORT=8083
CALIBRE_WEB_PORT=8084
KOMGA_PORT=25600

# Outils
CZKAWKA_PORT=5800
METUBE_PORT=8081
RCLONE_PORT=5572

# Monitoring
PROMETHEUS_PORT=9080
GRAFANA_PORT=3000

# =============================================================================
# DIVERS
# =============================================================================

RESTART_POLICY=unless-stopped
